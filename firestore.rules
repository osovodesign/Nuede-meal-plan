rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'super_admin' ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // 1. users: only authenticated admins can read/write
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // 2. mealPlans: public can read active meal plans only; admins can write
    match /mealPlans/{planId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // 3. customers: strictly private operational data; accessible by admins
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // 4. orders:
    // - public cannot query the entire orders collection
    // - read allowed if admin, or read by specific public orderCode lookup
    // - writes must be performed by admin or validated server operations
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. payments: strictly private financial records; no public access
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // 6. deliveries: internal dispatch records
    match /deliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    // 7. deliveryPersonnel: courier contact & fleet information
    match /deliveryPersonnel/{personnelId} {
      allow read, write: if isAdmin();
    }

    // 8. deliveryConfirmations: audit records for "I Received My Food"
    match /deliveryConfirmations/{confirmationId} {
      allow read: if isAdmin();
      // Allow create only with valid required fields and non-empty orderCode
      allow create: if request.resource.data.orderCode is string &&
                       request.resource.data.orderCode.size() > 0 &&
                       request.resource.data.confirmedAt is string;
      allow update, delete: if isAdmin();
    }

    // 9. settings: system configuration
    match /settings/{settingId} {
      allow read: if true; // public can read business profile & fee settings
      allow write: if isAdmin();
    }
  }
}
